# Adresse publique du site (domaine perso). Sur Vercel, l'URL *.vercel.app est utilisée par défaut
NEXT_PUBLIC_SITE_URL=

# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=
# Expéditeur (optionnel). Par défaut : onboarding@resend.dev, en attendant un domaine vérifié
CONTACT_FROM_EMAIL=

# Admin Keystatic (voir README) : "github" pour créer/utiliser l'app GitHub
NEXT_PUBLIC_KEYSTATIC_STORAGE=
# Remplis automatiquement par l'assistant Keystatic après création de l'app GitHub
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
